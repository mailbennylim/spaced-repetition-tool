<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job: keeps the Reader app running on the Mac mini and restarts it after crashes or reboots.
     Install: cp deploy/com.benny.reader.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.benny.reader.plist
     Edit the two paths below (project folder, node) to match this Mac: `which node` -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.benny.reader</string>
  <key>WorkingDirectory</key><string>/Users/benny/Documents/Work__no-gdrive/spaced-repetition-tool</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>node_modules/next/dist/bin/next</string>
    <string>start</string>
    <string>-p</string><string>3000</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key><string>production</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/benny/Library/Logs/reader.log</string>
  <key>StandardErrorPath</key><string>/Users/benny/Library/Logs/reader.error.log</string>
</dict>
</plist>
