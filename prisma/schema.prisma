// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Reading ────────────────────────────────────────────────────────────────

model Document {
  id           String        @id @default(cuid())
  title        String
  author       String?
  type         String        // 'article' | 'epub' | 'pdf' | 'email' | 'rss'
  url          String?       // original URL
  domain       String?       // e.g. "inma.org"
  siteName     String?
  excerpt      String?       // description / first sentences
  content      String?       // cleaned HTML (articles, emails, rss)
  filePath     String?       // /uploads/... for epub / pdf
  coverImage   String?       // local cover (epub / pdf)
  imageUrl     String?       // og:image for articles
  wordCount    Int?
  publishedAt  DateTime?

  // Where it lives. Library documents: 'inbox' | 'archive'. Feed documents have isFeed = true.
  location     String        @default("inbox")
  isFeed       Boolean       @default(false)
  seen         Boolean       @default(false)
  feedId       String?
  feed         Feed?         @relation(fields: [feedId], references: [id], onDelete: SetNull)

  progress     Float         @default(0)  // furthest point read, 0–1
  position     String?       // JSON: last location (scroll %, cfi, page)
  lastOpenedAt DateTime?
  note         String?       // document note
  savedUsing   String?       // 'app' | 'share' | 'bookmarklet' | 'email' | 'rss' | 'import'

  savedAt      DateTime      @default(now())
  movedAt      DateTime      @default(now())
  deletedAt    DateTime?     // set = in Trash
  updatedAt    DateTime      @updatedAt

  tags         DocumentTag[]
  highlights   Highlight[]

  @@index([isFeed, location, deletedAt])
  @@index([url])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  documents DocumentTag[]
}

model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([documentId, tagId])
}

model Feed {
  id            String      @id @default(cuid())
  kind          String      @default("rss") // 'rss' | 'newsletter'
  title         String
  url           String      @unique        // feed URL (rss) or sender address (newsletter)
  siteUrl       String?
  iconUrl       String?
  description   String?
  folderId      String?
  folder        FeedFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  etag          String?
  lastModified  String?
  lastFetchedAt DateTime?
  lastItemAt    DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())
  documents     Document[]
}

model FeedFolder {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  feeds     Feed[]
}

// ── Highlights & review ───────────────────────────────────────────────────

model Source {
  id          String      @id @default(cuid())
  name        String      // "Raindrop", "Readwise", "Manual"
  type        String      // "raindrop" | "readwise" | "manual"
  isActive    Boolean     @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  highlights  Highlight[]
}

model Highlight {
  id              String            @id @default(cuid())
  sourceId        String
  source          Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String            // ID from the source (or our own id for in-app highlights)
  documentId      String?           // set for highlights made in the app
  document        Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  kind            String            @default("text") // 'text' | 'image'
  text            String            // the highlighted text ('' for image highlights)
  imageUrl        String?
  note            String?
  color           String            @default("yellow") // yellow | green | blue | pink | purple
  position        String?           // JSON: {start,end} (article) | {cfi} (epub) | {page,rects} (pdf)
  title           String?           // denormalised source title (imported highlights)
  author          String?
  url             String?
  tags            String?           // comma-separated, read-only (imported)
  highlightedAt   DateTime
  importedAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  reviewSchedules ReviewSchedule[]

  @@unique([sourceId, externalId])
  @@index([documentId])
}

model ReviewSchedule {
  id            String    @id @default(cuid())
  highlightId   String
  highlight     Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  scheduledFor  DateTime  // When to review this highlight
  interval      Int       @default(1) // Days between reviews
  easeFactor    Float     @default(2.5)
  repetitions   Int       @default(0)
  lastReviewed  DateTime?
  quality       Int?
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([scheduledFor])
}

model SavedView {
  id        String   @id @default(cuid())
  name      String
  query     String
  pinned    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ── Settings ──────────────────────────────────────────────────────────────

model Settings {
  id                    String   @id @default(cuid())
  notificationTime      String   @default("09:00")
  notificationsEnabled  Boolean  @default(true)
  dailyHighlightsCount  Int      @default(10)
  timezone              String   @default("UTC")
  homeRows              String?  // JSON: ordered list of visible Home rows
  autoAdvance           Boolean  @default(false)
  autoHighlight         Boolean  @default(false)
  defaultColor          String   @default("yellow")
  readerFont            String   @default("serif")
  readerFontSize        Int      @default(20)
  readerLineHeight      Float    @default(1.4)
  readerLineWidth       String   @default("medium")
  ttsVoice              String?
  ttsRate               Float    @default(1)
  libraryEmailToken     String?
  feedEmailToken        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
